PORT=3001
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-server-only-supabase-secret-key
FRONTEND_ORIGIN=http://localhost:5173
ADMIN_EMAIL_ALLOWLIST=admin1@example.com,admin2@example.com
# Number of trusted reverse-proxy hops, or true/false. Keep false for direct local access.
TRUST_PROXY=false
# Rate limits use a 15-minute window by default; route-specific windows can override it.
RATE_LIMIT_WINDOW_MS=900000
REGISTRATION_RATE_LIMIT=300
ADMIN_LOGIN_RATE_LIMIT=10
ADMIN_SESSION_RATE_LIMIT=120
CHECK_IN_RATE_LIMIT=600
ADMIN_EXPORT_RATE_LIMIT=30
# Public browser-safe Supabase values used only to start Google OAuth:
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-browser-safe-supabase-anon-key
# Optional Vite setting for a separately hosted API:
# VITE_API_BASE_URL=http://localhost:3001

PORT=3001
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-server-only-supabase-secret-key
FRONTEND_ORIGIN=http://localhost:5173
ADMIN_EMAIL_ALLOWLIST=admin1@example.com,admin2@example.com
# Public browser-safe Supabase values used only to start Google OAuth:
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-browser-safe-supabase-anon-key
# Optional Vite setting for a separately hosted API:
# VITE_API_BASE_URL=http://localhost:3001
